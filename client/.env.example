VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Clerk publishable key (Clerk dashboard > API keys). Public by design; never put the secret key here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# --- AI job reading --------------------------------------------------------------------------------
# Recommended: run the DevScale AI server (see server/README.md). It keeps the AI key off the browser and
# answers CORS only for this app.
# VITE_AI_SERVER_URL=https://your-server.onrender.com   (production). Unset in `npm run dev` = http://localhost:8787
#
# --- Alternative, FOR LOCAL DEVELOPMENT ONLY (ignored if VITE_AI_SERVER_URL is set) ----------------
# Works without deploying the Supabase "ai" function. The key is visible to anyone who opens the
# page, so this is switched off in production builds (npm run build ignores it). Use a throwaway
# key you can revoke. Production should use the deployed function (key stays on the server).
# Defaults are Groq; for xAI Grok use VITE_AI_BASE_URL=https://api.x.ai/v1 and a model from docs.x.ai.
# VITE_AI_API_KEY=your-provider-key
# VITE_AI_BASE_URL=https://api.groq.com/openai/v1
# VITE_AI_MODEL=openai/gpt-oss-120b
