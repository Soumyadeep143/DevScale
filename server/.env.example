# Copy to .env (it is git-ignored) and fill in. Start with: npm start
GROQ_API_KEY=your-NEW-groq-key
# Your Clerk publishable key (public). The server uses it to know which sign-ins to trust.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Browser addresses allowed to call this server (comma-separated). Add your production site here.
ALLOWED_ORIGINS=http://localhost:5173
# Optional
# PORT=8787
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# RATE_LIMIT_PER_MINUTE=20
# Keep-alive for free hosts that sleep (Render). On Render it turns itself on using RENDER_EXTERNAL_URL.
# KEEP_ALIVE=off
# KEEP_ALIVE_URL=https://your-service.onrender.com
# KEEP_ALIVE_SECONDS=600
